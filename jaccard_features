        group = group.sort_values("Top_N")

        plt.plot(
            group["Top_N"],
            group["Jaccard"],
            marker="o",
            label=pair
        )

    plt.xlabel("Top N Features")
    plt.ylabel("Jaccard Similarity")

    plt.xticks([10, 20, 30])

    plt.title(
        "Feature Similarity Across Top N"
    )

    plt.legend(
        bbox_to_anchor=(1.05, 1),
        loc="upper left"
    )

    plt.tight_layout()
    plt.show()

