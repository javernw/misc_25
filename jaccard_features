def prepare_jaccard_trend(comparison_df):

    trend_df = comparison_df.melt(
        id_vars=[
            "Typology_1",
            "Typology_2"
        ],
        value_vars=[
            "Top_10_Jaccard",
            "Top_20_Jaccard",
            "Top_30_Jaccard"
        ],
        var_name="Top_N",
        value_name="Jaccard"
    )

    trend_df["Top_N"] = (
        trend_df["Top_N"]
        .str.extract(r"(\d+)")
        .astype(int)
    )

    trend_df["Typology_Pair"] = (
        trend_df["Typology_1"]
        + " vs "
        + trend_df["Typology_2"]
    )

    return trend_df

positive_jaccard_trend = prepare_jaccard_trend(
    positive_jaccard_comparison
)

