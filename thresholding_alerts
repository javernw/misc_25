2. Function to simulate eventing at a threshold

def simulate_eventing_at_threshold(scores_df, threshold):
    run_dates = [
        r[date_col]
        for r in scores_df.select(date_col).distinct().orderBy(date_col).collect()
    ]
    history = None
    monthly_outputs = []
    for run_date in run_dates:
        current_month = (
            scores_df
            .filter(F.col(date_col) == F.lit(run_date))
            .filter(F.col(score_col) >= F.lit(threshold))
        )
        if history is None:
            current_scored = (
                current_month
                .withColumn("last_event_date", F.lit(None).cast("date"))
                .withColumn("months_since_last_event", F.lit(None).cast("double"))
                .withColumn("suppressed_by_lookback", F.lit(False))
                .withColumn("new_event_flag", F.lit(True))
            )
        else:
            current_scored = (
                current_month
                .join(history, on=account_col, how="left")
                .withColumn(
                    "months_since_last_event",
                    F.months_between(F.col(date_col), F.col("last_event_date"))
                )
                .withColumn(
                    "suppressed_by_lookback",
                    (F.col("last_event_date").isNotNull()) &
                    (F.col("months_since_last_event") < lookback_months)
                )
                .withColumn(
                    "new_event_flag",
                    F.col("suppressed_by_lookback") == False
                )
            )
        newly_evented = current_scored.filter(F.col("new_event_flag") == True)
        monthly_summary = (
            current_scored
            .agg(
                F.lit(run_date).alias(date_col),
                F.lit(float(threshold)).alias("threshold"),
                F.count("*").alias("raw_above_threshold"),
                F.count(F.when(F.col("suppressed_by_lookback"), 1)).alias("suppressed_by_lookback"),
                F.count(F.when(F.col("new_event_flag"), 1)).alias("incremental_count")
            )
        )
        monthly_outputs.append(monthly_summary)
        new_history = (
            newly_evented
            .select(
                account_col,
                F.col(date_col).alias("last_event_date")
            )
        )
        if history is None:
            history = new_history
        else:
            history = (
                history
                .unionByName(new_history)
                .withColumn(
                    "rn",
                    F.row_number().over(
                        Window.partitionBy(account_col)
                        .orderBy(F.col("last_event_date").desc())
                    )
                )
                .filter(F.col("rn") == 1)
                .drop("rn")
            )
    result_df = reduce(lambda a, b: a.unionByName(b), monthly_outputs)
    return result_df

