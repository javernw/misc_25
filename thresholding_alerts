3. Binary search for the threshold

low = threshold_low
high = threshold_high
best_threshold = None
best_diff = float("inf")
best_avg_count = None
best_result_df = None
for i in range(max_iterations):
    mid = (low + high) / 2.0
    result_df = simulate_eventing_at_threshold(df_search, mid)
    # Exclude first month because it may have startup spike
    ordered_dates = [
        r[date_col]
        for r in result_df.select(date_col).distinct().orderBy(date_col).collect()
    ]
    steady_state_dates = ordered_dates[1:] if len(ordered_dates) > 1 else ordered_dates
    avg_count = (
        result_df
        .filter(F.col(date_col).isin(steady_state_dates))
        .agg(F.avg("incremental_count").alias("avg_incremental_count"))
        .collect()[0]["avg_incremental_count"]
    )
    diff = abs(avg_count - target_incremental)
    if diff < best_diff:
        best_diff = diff
        best_threshold = mid
        best_avg_count = avg_count
        best_result_df = result_df
    print(
        f"Iteration {i+1}: threshold={mid:.6f}, "
        f"avg_incremental={avg_count:.0f}, diff={diff:.0f}"
    )
    # Direction:
    # Too many new events = threshold too low, raise threshold
    if avg_count > max_target:
        low = mid
    # Too few new events = threshold too high, lower threshold
    elif avg_count < min_target:
        high = mid
    # Within range, stop
    else:
        best_threshold = mid
        best_avg_count = avg_count
        best_result_df = result_df
        break

