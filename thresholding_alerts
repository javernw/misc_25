B4. Dynamic cooldown logic

This logic:

* Starts with accounts above the dynamic threshold
* Suppresses accounts alerted within the last 3 months
* Allows accounts to re-alert after cooldown expires
* Does not backfill to force volume
* Checks whether final volume is within the 80% utilization range

run_dates = [
    row[date_col]
    for row in df_with_threshold
        .select(date_col)
        .distinct()
        .orderBy(date_col)
        .collect()
]
history = None
monthly_outputs = []
for run_date in run_dates:
    
    current_month = (
        df_with_threshold
        .filter(F.col(date_col) == F.lit(run_date))
        .filter(F.col("above_dynamic_threshold") == True)
    )
    
    if history is None:
        current_scored = (
            current_month
            .withColumn("last_alert_date", F.lit(None).cast("date"))
            .withColumn("months_since_last_alert", F.lit(None).cast("double"))
            .withColumn("suppressed_by_cooldown", F.lit(False))
            .withColumn("new_alert_flag", F.lit(True))
            .withColumn("repeat_after_cooldown_flag", F.lit(False))
        )
    else:
        current_scored = (
            current_month
            .join(history, on=account_col, how="left")
            .withColumn(
                "months_since_last_alert",
                F.months_between(F.col(date_col), F.col("last_alert_date"))
            )
            .withColumn(
                "suppressed_by_cooldown",
                (F.col("last_alert_date").isNotNull()) &
                (F.col("months_since_last_alert") < cooldown_months)
            )
            .withColumn(
                "new_alert_flag",
                F.col("last_alert_date").isNull()
            )
            .withColumn(
                "repeat_after_cooldown_flag",
                (F.col("last_alert_date").isNotNull()) &
                (F.col("months_since_last_alert") >= cooldown_months)
            )
        )
    
    # Final sent to Ops = eligible accounts only
    final_sent = current_scored.filter(F.col("suppressed_by_cooldown") == False)
    
    monthly_summary = (
        current_scored
        .agg(
            F.lit(run_date).alias(date_col),
            F.first("final_dynamic_threshold").alias("final_dynamic_threshold"),
            F.count("*").alias("raw_candidates_above_threshold"),
            F.count(F.when(F.col("suppressed_by_cooldown") == True, 1)).alias("suppressed_by_cooldown"),
            F.count(F.when(F.col("new_alert_flag") == True, 1)).alias("new_alerts"),
            F.count(F.when(F.col("repeat_after_cooldown_flag") == True, 1)).alias("repeat_after_cooldown"),
            F.count(F.when(F.col("suppressed_by_cooldown") == False, 1)).alias("final_sent_to_ops")
        )
        .withColumn(
            "within_80pct_utilization_range",
            (F.col("final_sent_to_ops") >= min_capacity) &
            (F.col("final_sent_to_ops") <= max_capacity)
        )
        .withColumn(
            "below_80pct_utilization_range",
            F.col("final_sent_to_ops") < min_capacity
        )
        .withColumn(
            "above_80pct_utilization_range",
            F.col("final_sent_to_ops") > max_capacity
        )
    )
    
    monthly_outputs.append(monthly_summary)
    
    # Update history with accounts actually sent to Ops
    new_history = (
        final_sent
        .select(
            account_col,
            F.col(date_col).alias("last_alert_date"),
            F.col(score_col).alias("last_alert_score")
        )
    )
    
    if history is None:
        history = new_history
    else:
        history = (
            history
            .unionByName(new_history)
            .withColumn(
                "rn",
                F.row_number().over(
                    Window.partitionBy(account_col)
                    .orderBy(F.col("last_alert_date").desc())
                )
            )
            .filter(F.col("rn") == 1)
            .drop("rn")
        )

