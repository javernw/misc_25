# SUPPRESSION HELPER

# 

# For a given month-end date T and a candidate threshold:

# - suppressed accounts = those that scored >= threshold in any of the

# SUPPRESSION_MONTHS prior month-end dates

# - net alerts = accounts scoring >= threshold in T that are NOT suppressed

# 

# We build this as a reusable function so it can be called once for the

# lower threshold volume check AND iteratively during upper threshold search.

# —————————————————————————

def build_suppression_lookup(df_eom, eom_dates, threshold, suppression_months=3):
“””
For each month-end date, identify which PARTY_KEYs are suppressed
(i.e. already alerted above threshold in the prior N months).

```
Returns a DataFrame with columns:
    scoring_date  — the current month-end date
    PARTY_KEY     — suppressed account
"""
suppression_frames = []

for current_date in eom_dates:
    # Find the prior N month-end dates relative to current_date
    prior_dates = [d for d in eom_dates if d < current_date]
    lookback_dates = prior_dates[-suppression_months:]  # most recent N prior dates

    if not lookback_dates:
        # No history available — no suppression for this month (warm-up)
        continue

    # Accounts alerted in any of the lookback months
    suppressed = (
        df_eom
        .filter(F.col("scoring_date").isin(lookback_dates))
        .filter(F.col("xgb_scr") >= threshold)
        .select("PARTY_KEY")
        .distinct()
        .withColumn("scoring_date", F.lit(current_date))
    )
    suppression_frames.append(suppressed)

if not suppression_frames:
    # Edge case: no suppression history at all (e.g. only 1 month of data)
    return spark.createDataFrame([], df_eom.select("PARTY_KEY", "scoring_date").schema)

return suppression_frames[0].unionAll(*suppression_frames[1:])
