def build_account_audit(df_eom, eom_dates, threshold, suppression_months=3,
                         sample_party_keys=None):
    """
    Trace the alert/suppress decision for each account across all months.
    Optionally filter to a list of specific PARTY_KEYs for spot-checking.

    Returns a Spark DataFrame with columns:
        PARTY_KEY, scoring_date, xgb_scr, above_threshold,
        in_suppression_pool, alerted
    """
    # Collect all scores into a dict keyed by (PARTY_KEY, date) for fast lookup
    rows = (
        df_eom
        .select("PARTY_KEY", "scoring_date", "xgb_scr")
        .collect()
    )
    score_lookup = {(r["PARTY_KEY"], r["scoring_date"]): r["xgb_scr"] for r in rows}
    all_parties  = list({r["PARTY_KEY"] for r in rows})

    if sample_party_keys:
        all_parties = [p for p in all_parties if p in sample_party_keys]

    alert_history = deque(maxlen=suppression_months)
    audit_rows    = []

    for i, current_date in enumerate(eom_dates):
        suppression_pool = set().union(*alert_history) if alert_history else set()
        net_alerted_this_month = set()

        for party in all_parties:
            score = score_lookup.get((party, current_date))
            if score is None:
                continue   # account not scored this month

            above     = score >= threshold
            suppressed = party in suppression_pool
            alerted   = above and not suppressed

            audit_rows.append({
                "PARTY_KEY":           party,
                "scoring_date":        current_date,
                "xgb_scr":             float(score),
                "above_threshold":     above,
                "in_suppression_pool": suppressed,
                "alerted":             alerted,
            })

            if alerted:
                net_alerted_this_month.add(party)

        alert_history.append(net_alerted_this_month)

    return spark.createDataFrame(audit_rows).orderBy("PARTY_KEY", "scoring_date")


# To audit specific accounts (e.g. ones you know score consistently high),
# pass their PARTY_KEYs here. Leave as None to audit all accounts (can be large).
SAMPLE_KEYS = None   # e.g. ["ACC001", "ACC002"]

df_audit = build_account_audit(
    df_eom, eom_dates, upper_threshold,
    suppression_months=SUPPRESSION_MONTHS,
    sample_party_keys=SAMPLE_KEYS
)

# Show a sample of accounts that were alerted more than once — these are the
