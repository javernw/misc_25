    .filter(F.col("times_alerted") > 1)   # accounts alerted more than once
    .orderBy("PARTY_KEY", "scoring_date")
)

print("\nAccounts alerted more than once (re-alerting after suppression lifted):")
df_audit_summary.show(50, truncate=False)


