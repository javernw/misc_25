def compute_net_alerts(df_eom, eom_dates, threshold, suppression_months=3):
“””
For each month-end date, compute:
- gross_alerts      : accounts above threshold (no suppression)
- suppressed_count  : accounts above threshold but suppressed
- net_alerts        : gross - suppressed (new alerts only)
- warm_up_month     : True if fewer than N months of history available

```
Returns a summary DataFrame with one row per scoring_date.
"""
df_suppressed = build_suppression_lookup(df_eom, eom_dates, threshold, suppression_months)

# Tag each candidate alert with whether it is suppressed
df_candidates = df_eom.filter(F.col("xgb_scr") >= threshold)

df_tagged = (
    df_candidates
    .join(
        df_suppressed.withColumn("is_suppressed", F.lit(True)),
        on=["PARTY_KEY", "scoring_date"],
        how="left"
    )
    .withColumn("is_suppressed", F.coalesce(F.col("is_suppressed"), F.lit(False)))
)

# Summarise per month
df_summary = (
    df_tagged
    .groupBy("scoring_date")
    .agg(
        F.count("PARTY_KEY").alias("gross_alerts"),
        F.sum(F.when(F.col("is_suppressed"), 1).otherwise(0)).alias("suppressed_count"),
        F.sum(F.when(~F.col("is_suppressed"), 1).otherwise(0)).alias("net_alerts"),
    )
    .orderBy("scoring_date")
)

# Flag warm-up months (fewer than SUPPRESSION_MONTHS of prior data)
warm_up_dates = eom_dates[:suppression_months]
df_summary = df_summary.withColumn(
    "warm_up_month",
    F.col("scoring_date").isin(warm_up_dates)
)

return df_summary
