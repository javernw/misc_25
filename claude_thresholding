"""
Model Thresholding Analysis in PySpark — v4
============================================
Updates from v3:
- Fixed suppression logic: suppression is now based on accounts ACTUALLY ALERTED
  (i.e. scored high AND not suppressed that month), not just scored above threshold.
- This prevents permanently suppressing consistently high-scoring accounts.
- Effect: a high-scoring account re-alerts every N months (suppression window),
  rather than alerting once in January and never again.
- Months are now processed SEQUENTIALLY — each month's alert decisions feed
  forward into the next month's suppression pool.
- All other parts (lower threshold, typology check, band search) are unchanged.
- Assumes input dataset has columns: PARTY_KEY, scoring_date, xgb_scr
"""

from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql import Window
from collections import deque

spark = SparkSession.builder.appName("ThresholdingAnalysis").getOrCreate()

# ---------------------------------------------------------------------------
# SETUP
# ---------------------------------------------------------------------------

df_scores     = spark.table("your_database.scored_population")
df_sars       = spark.table("your_database.sar_population")
df_sars_typology = spark.table("your_database.sar_typology")

# ---------------------------------------------------------------------------
# CONFIG
# ---------------------------------------------------------------------------

SUPPRESSION_MONTHS = 3
BAND_LOWER         = 4_500
BAND_MID           = 5_000
BAND_UPPER         = 5_500
USE_80_PCT_VARIANT = False

if USE_80_PCT_VARIANT:
    BAND_LOWER = int(BAND_LOWER * 0.8)   # 3,600
    BAND_MID   = int(BAND_MID   * 0.8)   # 4,000
    BAND_UPPER = int(BAND_UPPER * 0.8)   # 4,400
    print(f"Using 80% variant band: [{BAND_LOWER:,} – {BAND_UPPER:,}]")
else:
    print(f"Using standard band: [{BAND_LOWER:,} – {BAND_UPPER:,}]")


# ---------------------------------------------------------------------------
# PART 1: LOWER THRESHOLD — 3rd Percentile of SAR Scores (unchanged)
# ---------------------------------------------------------------------------

df_sar_scores = df_sars.select("PARTY_KEY").join(
    df_scores.select("PARTY_KEY", "xgb_scr"),
    on="PARTY_KEY",
    how="inner"
)

lower_threshold_row = df_sar_scores.approxQuantile("xgb_scr", [0.03], 0.001)
lower_threshold = lower_threshold_row[0]
print(f"\nLower Threshold (3rd percentile of SAR scores): {lower_threshold:.4f}")


# ---------------------------------------------------------------------------
# PART 1b: Typology-level sanity check (unchanged)
# ---------------------------------------------------------------------------

df_sar_typology_scores = df_sars_typology.join(
    df_scores.select("PARTY_KEY", "xgb_scr"),
    on="PARTY_KEY",
    how="inner"
)

df_typology_check = (
    df_sar_typology_scores
    .groupBy("typology")
    .agg(
        F.count("PARTY_KEY").alias("total_sars"),
        F.sum(F.when(F.col("xgb_scr") < lower_threshold, 1).otherwise(0)).alias("missed_sars")
    )
    .withColumn("miss_rate_pct", F.round((F.col("missed_sars") / F.col("total_sars")) * 100, 2))
    .withColumn("exceeds_3pct",  F.col("miss_rate_pct") > 3.0)
    .withColumn("low_count_flag", F.col("total_sars") < 30)
    .orderBy(F.col("miss_rate_pct").desc())
)

print("\nTypology-level SAR coverage check:")
df_typology_check.show(truncate=False)


# ---------------------------------------------------------------------------
# PART 2 SETUP: Filter to end-of-month runs
# ---------------------------------------------------------------------------

df_eom = df_scores.filter(
    F.col("scoring_date") == F.last_day(F.col("scoring_date"))
)

# Cache — will be scanned repeatedly during threshold search
df_eom.cache()

eom_dates = sorted([
    row["scoring_date"]
    for row in df_eom.select("scoring_date").distinct().collect()
])

print(f"\nMonth-end dates found: {[str(d) for d in eom_dates]}")


# ---------------------------------------------------------------------------
# CORE: SEQUENTIAL SUPPRESSION ENGINE (fixed in v4)
#
# Key change from v3:
#   v3 suppressed based on "scored above threshold in prior N months"
#   v4 suppresses based on "was ACTUALLY ALERTED in prior N months"
#
# These differ because a suppressed account is NOT alerted even if it scores
# high — so it must NOT feed back into the suppression pool for future months.
#
# Algorithm (month by month):
#   1. Start with an empty alert history deque of max length SUPPRESSION_MONTHS
#   2. For each month T:
#       a. Build suppression pool = union of all PARTY_KEYs alerted in deque
#       b. Candidates = accounts scoring >= threshold in month T
#       c. Net alerts = candidates NOT in suppression pool
#       d. Push net alerts into the deque (dropping oldest if full)
#   3. Record gross, suppressed, net counts per month
#
# The deque naturally expires alerts older than SUPPRESSION_MONTHS months
# because it only holds the most recent N months of alert sets.
# ---------------------------------------------------------------------------

def compute_net_alerts_sequential(df_eom, eom_dates, threshold,
                                   suppression_months=3):
    """
    Process months sequentially, suppressing accounts based on whether they
    were ACTUALLY ALERTED (not just scored high) in the prior N months.

    Returns a list of dicts with one entry per month:
        scoring_date, gross_alerts, suppressed_count, net_alerts, warm_up_month
    """

    # Pre-collect candidates per month to avoid repeated Spark scans in the loop.
    # For large populations this is a set of PARTY_KEYs above threshold per month.
    # We collect to Python sets for O(1) suppression lookups.
    monthly_candidates = {}
    for date in eom_dates:
        candidates = (
            df_eom
            .filter(F.col("scoring_date") == date)
            .filter(F.col("xgb_scr") >= threshold)
            .select("PARTY_KEY")
            .rdd.map(lambda r: r["PARTY_KEY"])
            .collect()
        )
        monthly_candidates[date] = set(candidates)

    # Rolling deque of alert sets — max length = suppression window
    # Each slot = set of PARTY_KEYs actually alerted in that month
    # Oldest month drops off automatically when deque is full
    alert_history = deque(maxlen=suppression_months)

    results = []

    for i, current_date in enumerate(eom_dates):

        # Build suppression pool from all months currently in the deque
        # (these are accounts actually alerted in the prior N months)
        suppression_pool = set().union(*alert_history) if alert_history else set()

        candidates = monthly_candidates[current_date]

        # Net alerts = candidates not in suppression pool
        net_alerted     = candidates - suppression_pool
        suppressed      = candidates & suppression_pool   # intersection

        gross_count      = len(candidates)
        suppressed_count = len(suppressed)
        net_count        = len(net_alerted)
        warm_up          = i < suppression_months

        results.append({
            "scoring_date":     current_date,
            "gross_alerts":     gross_count,
            "suppressed_count": suppressed_count,
            "net_alerts":       net_count,
            "warm_up_month":    warm_up,
        })

        # Push this month's NET alerts (actually alerted) into history
        # NOT the full candidate set — this is the fix vs v3
        alert_history.append(net_alerted)

    return results


def results_to_df(results):
    """Convert list of monthly result dicts to a Spark DataFrame."""
    return spark.createDataFrame(results).orderBy("scoring_date")


def avg_net_alerts_at_threshold(df_eom, eom_dates, threshold,
                                 suppression_months=3, exclude_warmup=True):
    """Return average monthly net alerts at a given threshold (excl. warm-up)."""
    results = compute_net_alerts_sequential(
        df_eom, eom_dates, threshold, suppression_months
    )
    filtered = [r for r in results if not r["warm_up_month"]] if exclude_warmup else results
    if not filtered:
        return 0.0
    return sum(r["net_alerts"] for r in filtered) / len(filtered)


