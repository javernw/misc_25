    F.col("net_alerts").between(BAND_LOWER, BAND_UPPER)
)

print(f"\nMonthly breakdown at threshold {upper_threshold:.5f}:")
df_final_display.show(truncate=False)

# Summary stats — exclude warm-up months
calibration = [r for r in final_results if not r["warm_up_month"]]
total_months    = len(calibration)
months_in_band  = sum(1 for r in calibration if BAND_LOWER <= r["net_alerts"] <= BAND_UPPER)
final_avg_net   = sum(r["net_alerts"]      for r in calibration) / total_months
avg_suppressed  = sum(r["suppressed_count"] for r in calibration) / total_months

print(f"  Months within band [{BAND_LOWER:,}–{BAND_UPPER:,}]: {months_in_band} / {total_months}")
print(f"  Average net alerts/month:    {final_avg_net:,.0f}")
print(f"  Average suppressed/month:    {avg_suppressed:,.0f}")


