# PART 2: ALERT VOLUME AT LOWER THRESHOLD — with corrected suppression
# ---------------------------------------------------------------------------

print(f"\n{'='*60}")
print("PART 2 — Alert volume at lower threshold (corrected suppression)")
print(f"{'='*60}")

lower_results = compute_net_alerts_sequential(
    df_eom, eom_dates, lower_threshold, SUPPRESSION_MONTHS
)
df_lower_volume = results_to_df(lower_results)
df_lower_volume.show(truncate=False)

avg_net_lower = (
    sum(r["net_alerts"] for r in lower_results if not r["warm_up_month"])
    / sum(1 for r in lower_results if not r["warm_up_month"])
)
print(f"Avg net alerts/month at lower threshold (excl. warm-up): {avg_net_lower:,.0f}")


# ---------------------------------------------------------------------------
# PART 3: UPPER THRESHOLD — Band search with corrected suppression
#
# Same two-pass approach as v3 (coarse percentile scan → binary search)
# but now using the corrected sequential suppression engine.
# ---------------------------------------------------------------------------

print(f"\n{'='*60}")
print("PART 3 — Finding upper threshold (corrected suppression)")
print(f"{'='*60}")


# --- Pass 1: Coarse scan across score percentiles ---

percentile_steps      = [i / 100 for i in range(50, 100)]
candidate_thresholds  = df_eom.approxQuantile("xgb_scr", percentile_steps, 0.005)

print(f"\nPass 1 — Coarse search | Target band: [{BAND_LOWER:,} – {BAND_UPPER:,}]")

coarse_results = []
for pct, thresh in zip(percentile_steps, candidate_thresholds):
    avg_net = avg_net_alerts_at_threshold(
        df_eom, eom_dates, thresh, SUPPRESSION_MONTHS
    )
    coarse_results.append((pct, thresh, avg_net))
    print(f"  Percentile {pct:.0%}  threshold={thresh:.5f}  avg_net_alerts={avg_net:,.0f}")
    if avg_net < BAND_LOWER:
        break

in_band    = [(p, t, a) for p, t, a in coarse_results if a >= BAND_LOWER]
below_band = [(p, t, a) for p, t, a in coarse_results if a <  BAND_LOWER]

bracket_lo = in_band[-1][1]    if in_band    else candidate_thresholds[0]
bracket_hi = below_band[0][1]  if below_band else candidate_thresholds[-1]
print(f"\n  Bracket found: [{bracket_lo:.5f}, {bracket_hi:.5f}]")


# --- Pass 2: Binary search within bracket ---

print("\nPass 2 — Binary search within bracket:")

lo, hi         = bracket_lo, bracket_hi
tolerance      = 10     # within 10 alerts of BAND_MID is close enough
max_iter       = 20
best_threshold = None
best_avg_net   = None

for i in range(max_iter):
    mid     = (lo + hi) / 2
    avg_net = avg_net_alerts_at_threshold(
        df_eom, eom_dates, mid, SUPPRESSION_MONTHS
    )
    print(f"  Iter {i+1:02d}  threshold={mid:.5f}  avg_net_alerts={avg_net:,.0f}")

    best_threshold = mid
    best_avg_net   = avg_net

    if abs(avg_net - BAND_MID) <= tolerance:
        print(f"  Converged.")
        break

    if avg_net > BAND_MID:
        lo = mid   # raise threshold to reduce alerts
    else:
        hi = mid   # lower threshold to increase alerts

upper_threshold = best_threshold
print(f"\nUpper Threshold (corrected suppression): {upper_threshold:.5f}")
print(f"Average net alerts at this threshold:    {best_avg_net:,.0f}")


# ---------------------------------------------------------------------------
# PART 3b: FULL SANITY CHECK — Monthly breakdown at final upper threshold
# ---------------------------------------------------------------------------

print(f"\n{'='*60}")
print("PART 3b — Monthly breakdown at final upper threshold")
print(f"{'='*60}")

final_results = compute_net_alerts_sequential(
